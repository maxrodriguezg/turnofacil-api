{
  "cluster": "${ECS_CLUSTER}",
  "serviceName": "turnofacil-api",
  "taskDefinition": "turnofacil-api",
  "desiredCount": ${API_DESIRED_COUNT},
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["${SUBNET1}", "${SUBNET2}"],
      "securityGroups": ["${SG_API}"],
      "assignPublicIp": "ENABLED"
    }
  },
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "${NAMESPACE}",
    "services": [
      {
        "portName": "api-port",
        "discoveryName": "turnofacil-api",
        "clientAliases": [
          { "port": 8080, "dnsName": "turnofacil-api" }
        ]
      }
    ]
  }
}
