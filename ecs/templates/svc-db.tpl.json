{
  "cluster": "${ECS_CLUSTER}",
  "serviceName": "turnofacil-db",
  "taskDefinition": "turnofacil-db",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["${SUBNET1}", "${SUBNET2}"],
      "securityGroups": ["${SG_DB}"],
      "assignPublicIp": "ENABLED"
    }
  },
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "${NAMESPACE}",
    "services": [
      {
        "portName": "db-port",
        "discoveryName": "db",
        "clientAliases": [
          { "port": 5432, "dnsName": "db" }
        ]
      }
    ]
  }
}
